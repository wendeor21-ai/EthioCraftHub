# ─── DATABASE ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ethiocraft_global?schema=public

# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development           # development | production

# ─── JWT AUTHENTICATION ───────────────────────────────────────────────────────
JWT_SECRET=replace_with_64_char_random_string
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=replace_with_another_64_char_random_string
JWT_REFRESH_EXPIRE=30d
BCRYPT_SALT_ROUNDS=12

# ─── SESSION (OAuth only) ─────────────────────────────────────────────────────
SESSION_SECRET=replace_with_random_session_secret

# ─── CORS & URLS ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ─── GOOGLE OAUTH ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ─── CHAPA PAYMENT GATEWAY ────────────────────────────────────────────────────
CHAPA_SECRET_KEY=CHASECK_TEST-your_chapa_secret_key
CHAPA_CALLBACK_URL=http://localhost:3000/payment/callback
CHAPA_RETURN_URL=http://localhost:3000/payment/success

# ─── AI SERVICES ──────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=AIzaSy_your_gemini_api_key

# ─── EMAIL (SMTP) ─────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=no-reply@ethiocraft.com

# ─── CLOUDINARY (Image Uploads) ───────────────────────────────────────────────
# Leave blank to use local disk storage (/uploads) in development
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_FOLDER=ethiocraft

# ─── RATE LIMITING (production) ───────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes in ms
RATE_LIMIT_MAX_REQUESTS=100

# ─── ADMIN CREATION ───────────────────────────────────────────────────────────
# Required to use POST /api/auth/create-admin. Leave blank to disable the route.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_CREATION_KEY=replace_with_strong_random_key

# ─── CORS (allowed origins for /uploads and API) ──────────────────────────────
# Comma-separated list of allowed frontend origins (no wildcards)
ALLOWED_ORIGINS=http://localhost:3000

# ─── SECURE COOKIES ───────────────────────────────────────────────────────────
# Set to 'true' in staging/production when behind HTTPS or a TLS proxy
COOKIE_SECURE=false
