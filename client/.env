# Disable source maps to avoid jspdf source map errors
GENERATE_SOURCEMAP=false

# Ignore source map warnings
SKIP_PREFLIGHT_CHECK=true

# Fix Webpack Dev Server allowedHosts error
DANGEROUSLY_DISABLE_HOST_CHECK=true
HOST=localhost
PORT=3000
WDS_SOCKET_HOST=localhost
# ALLOWED_HOSTS=localhost (removed to avoid schema errors if misconfigured)

# Backend API URL (Standardized to Port 5000)
REACT_APP_API_URL=http://localhost:5000/api
