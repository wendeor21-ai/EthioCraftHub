# =======================================================
# EthioCraft Global - Production Client Environment
# Target Domain: https://ethiocrafthub.com
# =======================================================

# Disable source maps in production for speed & security
GENERATE_SOURCEMAP=false
SKIP_PREFLIGHT_CHECK=true

# Backend API Endpoint
# Change to https://api.ethiocrafthub.com/api if your backend is hosted on a subdomain
REACT_APP_API_URL=https://ethiocrafthub.com/api

